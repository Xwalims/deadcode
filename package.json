{
  "name": "deadcode",
  "version": "1.0.0",
  "description": "Fast, accurate dead code detection for JavaScript and TypeScript projects.",
  "type": "module",
  "bin": {
    "deadcode": "dist/src/cli/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test 'dist/tests/**/*.test.js'",
    "test:quick": "node --test 'dist/tests/**/*.test.js'",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "deadcode",
    "unused",
    "lint",
    "static-analysis",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
